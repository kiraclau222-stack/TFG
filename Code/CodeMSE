import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf

from numpy.lib.stride_tricks import sliding_window_view
from sklearn.preprocessing import MinMaxScaler

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, RepeatVector, TimeDistributed, Dense
from tensorflow.keras.callbacks import EarlyStopping


# ============================================================
# CONFIGURACIÓN
# ============================================================

HOUSE_ID = 661
FILE = "15minute_data_austin.csv"

T = 96                      # 96 intervalos de 15 minutos = 24 horas
EPOCHS = 15
BATCH_SIZE = 256
SEED = 42


# ============================================================
# REPRODUCIBILIDAD
# ============================================================

np.random.seed(SEED)
tf.random.set_seed(SEED)


# ============================================================
# 1. CARGAR DATOS
# ============================================================

print(f"Cargando vivienda {HOUSE_ID}...")

df = pd.read_csv(
    FILE,
    parse_dates=["local_15min"]
)

df = (
    df[df["dataid"] == HOUSE_ID]
    .sort_values("local_15min")
    .reset_index(drop=True)
)

if df.empty:
    raise ValueError(
        f"No se encontraron datos para la vivienda {HOUSE_ID}."
    )

print(f"Registros encontrados: {len(df)}")


# ============================================================
# 2. SELECCIONAR SOLO 'use' Y ELECTRODOMÉSTICOS PRINCIPALES
# ============================================================

main_appliances = [
    "air1",
    "clotheswasher1",
    "furnace1",
    "dishwasher1",
    "drye1",
    "refrigerator1",
    "range1",
    "oven1",
    "use"
]

circuit_cols = [
    col for col in main_appliances
    if col in df.columns and pd.api.types.is_numeric_dtype(df[col])
]

if not circuit_cols:
    raise ValueError(
        "No se encontraron las columnas especificadas en el dataset."
    )

print(f"Columnas principales utilizadas: {circuit_cols}")


# ============================================================
# 3. TRATAMIENTO DE VALORES FALTANTES (CON ANÁLISIS PREVIO)
# ============================================================

missing_data = df[circuit_cols].isnull().sum()
missing_percentage = (missing_data / len(df)) * 100

print("\n--- ANÁLISIS DE VALORES AUSENTES POR CIRCUITO ---")
missing_df = pd.DataFrame({
    "Valores Nulos": missing_data,
    "Porcentaje (%)": missing_percentage
})
print(missing_df)

df[circuit_cols] = (
    df[circuit_cols]
    .interpolate()
    .bfill()
    .ffill()
)


# ============================================================
# 4. ASEGURAR Y COMPROBAR CONSUMO TOTAL DE LA VIVIENDA ('use')
# ============================================================

if "use" not in df.columns:
    appliance_cols = [c for c in circuit_cols if c != "use"]
    df["use"] = df[appliance_cols].sum(axis=1)

series = df["use"].to_numpy(
    dtype=np.float32
)

print(f"Registros de consumo: {len(series)}")


# ============================================================
# 5. NORMALIZACIÓN
# ============================================================

scaler = MinMaxScaler()

series_scaled = scaler.fit_transform(
    series.reshape(-1, 1)
).flatten().astype(np.float32)

print("Normalización completada.")


# ============================================================
# 6. CREAR VENTANAS TEMPORALES
# ============================================================

if len(series_scaled) < T:
    raise ValueError(
        f"No hay suficientes registros para crear "
        f"ventanas de {T} intervalos."
    )

X = sliding_window_view(
    series_scaled,
    T
)

X = X[
    ...,
    np.newaxis
].astype(np.float32)

print(f"Ventanas creadas: {X.shape}")


# ============================================================
# 7. MODELO LSTM AUTOENCODER
# ============================================================

model = Sequential([
    LSTM(
        32,
        input_shape=(T, 1)
    ),

    RepeatVector(T),

    LSTM(
        32,
        return_sequences=True
    ),

    TimeDistributed(
        Dense(1)
    )
])


# ============================================================
# 8. COMPILACIÓN
# ============================================================

model.compile(
    optimizer="adam",
    loss="mse"
)


# ============================================================
# 9. EARLY STOPPING
# ============================================================

early_stop = EarlyStopping(
    monitor="val_loss",
    patience=2,
    restore_best_weights=True,
    verbose=1
)


# ============================================================
# 10. ENTRENAMIENTO
# ============================================================

print("\nIniciando entrenamiento...")

history = model.fit(
    X,
    X,
    epochs=EPOCHS,
    batch_size=BATCH_SIZE,
    validation_split=0.1,
    callbacks=[early_stop],
    verbose=1,
    shuffle=False
)


# ============================================================
# 11. RESULTADOS DEL ENTRENAMIENTO
# ============================================================

epochs_ran = len(
    history.history["loss"]
)

early_stopping_activated = (
    epochs_ran < EPOCHS
)

print("\n======================================")
print("RESULTADO DEL ENTRENAMIENTO")
print("======================================")

print(f"Vivienda: {HOUSE_ID}")
print(f"Ventanas utilizadas: {len(X)}")
print(f"Épocas ejecutadas: {epochs_ran}")
print(f"Épocas máximas: {EPOCHS}")

if early_stopping_activated:
    print("Early Stopping: ACTIVADO")
    print(
        f"El entrenamiento se detuvo en la época "
        f"{epochs_ran}."
    )
else:
    print("Early Stopping: NO ACTIVADO")
    print(
        f"El entrenamiento completó las "
        f"{EPOCHS} épocas establecidas."
    )


# ============================================================
# 12. GRÁFICA DE LA FUNCIÓN DE PÉRDIDA
# ============================================================

plt.figure(
    figsize=(8, 5),
    dpi=300
)

epochs = range(
    1,
    epochs_ran + 1
)

plt.plot(
    epochs,
    history.history["loss"],
    label="Entrenamiento",
    linewidth=2
)

plt.plot(
    epochs,
    history.history["val_loss"],
    label="Validación",
    linewidth=2,
    linestyle="--"
)

if early_stopping_activated:
    plt.axvline(
        epochs_ran,
        linestyle=":",
        color="purple",
        linewidth=2,
        label=f"Early Stopping (época {epochs_ran})"
    )

plt.title(
    f"Vivienda {HOUSE_ID} - Evolución del MSE"
)

plt.xlabel("Época")
plt.ylabel("MSE")

plt.xticks(
    list(epochs)
)

plt.grid(
    True,
    linestyle="--",
    alpha=0.4
)

plt.legend()

plt.xlim(
    1,
    epochs_ran
)

plt.tight_layout()


# ============================================================
# 13. GUARDAR FIGURA
# ============================================================

output_file = (
    f"figura_5_1_loss_{HOUSE_ID}.png"
)

plt.savefig(
    output_file,
    dpi=300,
    bbox_inches="tight"
)

plt.show()

print(
    f"\nFigura guardada como: {output_file}"
)
